# Copy to .env and fill in. The scripts load this automatically (also for cron).

# --- Required ---
# Your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional (sensible defaults shown) ---
# OpenRouter model id for answering. Any chat model works.
RAG_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Which mail to index (Gmail search syntax).
GMAIL_FILTER=to: me label:inbox

# Absolute path for the persisted vector DB. Defaults to ./gmail_db next to the
# scripts if unset. Set it explicitly if cron/OpenClaw run from elsewhere.
# GMAIL_DB_DIR=/opt/gmail-rag/gmail_db
